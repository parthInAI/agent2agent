{
  "agents": [
    {
      "name": "SummarizationAgent",
      "capabilities": ["summarize"],
      "endpoint": "http://localhost:8001/summarize",
      "port": 8001,
      "description": "Summarizes long text into concise form"
    },
    {
      "name": "TextGeneratorAgent",
      "capabilities": ["generate_text"],
      "endpoint": "http://localhost:8002/generate",
      "port": 8002,
      "description": "Generates AI-style text continuations"
    },
    {
      "name": "SentimentAnalysisAgent",
      "capabilities": ["sentiment_analysis"],
      "endpoint": "http://localhost:8003/analyze",
      "port": 8003,
      "description": "Analyzes sentiment polarity and subjectivity using TextBlob"
    }
  ]
}
